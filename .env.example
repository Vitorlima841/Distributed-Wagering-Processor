ROLE=all
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://wagering:wagering@localhost:5433/wagering
DB_LOCK_TIMEOUT_MS=5000
# sessão parada no meio de uma transação é derrubada (maior que OUTBOX_PUBLISH_TIMEOUT_MS)
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
DB_POOL_MAX=10
# DB_APPLICATION_NAME=wagering-all   # padrão: wagering-<ROLE>; aparece no pg_stat_activity

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wagering-events

# consumer de wager-transactions.fifo (ARCHITECTURE §18)
SQS_CONSUMER_NAME=wager-transactions-consumer
# long poll; o shutdown espera o que estiver em andamento
SQS_WAIT_TIME_SECONDS=10
SQS_MAX_MESSAGES=10
SQS_VISIBILITY_TIMEOUT_S=30
# backoff de erro transitório: min(base × 2^(n−1), máximo), em segundos
SQS_RETRY_BASE_DELAY_S=2
SQS_RETRY_MAX_DELAY_S=60
SQS_SHUTDOWN_TIMEOUT_MS=15000

# outbox publisher (ARCHITECTURE §19): lote por transação, espera sem trabalho, prazo do SQS
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_PUBLISH_TIMEOUT_MS=10000

# worker de PENDING_REFERENCE (ARCHITECTURE §19): 10 tentativas ≈ 5 min até REFERENCE_NOT_FOUND
PENDING_REF_BATCH_SIZE=100
PENDING_REF_POLL_INTERVAL_MS=1000
PENDING_REF_MAX_ATTEMPTS=10
